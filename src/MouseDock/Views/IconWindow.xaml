<Window x:Class="MouseDock.Views.IconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MouseDock.Controls"
        Title="MouseDock 图标"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Grid Width="96" Height="96" MouseRightButtonUp="OnContextMenu">

        <!-- 角色款 -->
        <Border x:Name="CharLayer" CornerRadius="20" Width="96" Height="96"
                MouseLeftButtonDown="OnDragWindow" MouseWheel="OnWheel">
            <Border.Background>
                <ImageBrush x:Name="CharBrush" Stretch="UniformToFill" />
            </Border.Background>
            <Grid>
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,7"
                        CornerRadius="7" Padding="9,2" Background="#C4101018">
                    <TextBlock x:Name="CharPlateText" Text="86%" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" />
                </Border>
            </Grid>
        </Border>

        <!-- 照片款 -->
        <Border x:Name="PhotoLayer" CornerRadius="20" Width="96" Height="96" Visibility="Collapsed"
                MouseLeftButtonDown="OnPhotoMouseDown" MouseMove="OnPhotoMouseMove"
                MouseLeftButtonUp="OnPhotoMouseUp" MouseWheel="OnWheel">
            <Border.Background>
                <ImageBrush x:Name="PhotoBrush" Stretch="UniformToFill" />
            </Border.Background>
            <Grid>
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="7,0,0,7"
                        CornerRadius="6" Padding="6,1,6,2" Background="#B0000000">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="电量 " FontSize="9" Foreground="#D9FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                        <TextBlock x:Name="PhotoPlateText" Text="76%" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 迷你款 -->
        <Border x:Name="MiniLayer" CornerRadius="20" Width="96" Height="96" Visibility="Collapsed"
                MouseLeftButtonDown="OnDragWindow">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                    <GradientStop x:Name="MiniTop" Color="#221B3B" Offset="0" />
                    <GradientStop x:Name="MiniBottom" Color="#120F22" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <c:DeviceGlyph x:Name="MiniGlyph" Kind="Mouse" Width="17" Height="17" HorizontalAlignment="Center"
                               GlyphBrush="#B4A5D6" Margin="0,0,0,2" />
                <TextBlock x:Name="MiniText" Text="86%" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="#ECE7FA" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
