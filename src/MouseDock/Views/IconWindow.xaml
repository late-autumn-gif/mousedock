<Window x:Class="MouseDock.Views.IconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MouseDock.Controls"
        Title="MouseDock 图标"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Grid x:Name="RootGrid" Width="96" Height="96" MouseRightButtonUp="OnContextMenu">

        <Grid x:Name="LegacyLayers">
        <!-- 角色款 -->
        <Border x:Name="CharLayer" CornerRadius="20" Width="96" Height="96"
                MouseLeftButtonDown="OnDragWindow" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd"
                MouseWheel="OnWheel">
            <Border.Background>
                <ImageBrush x:Name="CharBrush" Stretch="UniformToFill" />
            </Border.Background>
            <Grid>
                <Border x:Name="CharPlate" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,7" CornerRadius="7" Padding="9,2" Background="#C4101018">
                    <TextBlock x:Name="CharPlateText" Text="" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" />
                </Border>
            </Grid>
        </Border>

        <!-- 照片款 -->
        <Border x:Name="PhotoLayer" CornerRadius="20" Width="96" Height="96" Visibility="Collapsed"
                MouseLeftButtonDown="OnDragWindow" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd"
                MouseWheel="OnWheel">
            <Border.Background>
                <ImageBrush x:Name="PhotoBrush" Stretch="UniformToFill" />
            </Border.Background>
            <Grid>
                <Grid.Resources>
                    <LinearGradientBrush x:Key="OtterBackground" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#15365B" />
                        <GradientStop Color="#285D75" Offset="0.58" />
                        <GradientStop Color="#263654" Offset="1" />
                    </LinearGradientBrush>
                    <BitmapImage x:Key="RikkaPortrait" UriSource="/MouseDock;component/Assets/Characters/Rikka.jpg" />
                    <BitmapImage x:Key="RoxyPortrait" UriSource="/MouseDock;component/Assets/Characters/Roxy.jpg" />
                </Grid.Resources>
                <Border x:Name="CharacterDevicePanel" Margin="0,48,0,0" CornerRadius="16"
                        Background="{StaticResource OtterBackground}" Visibility="Collapsed" />
                <Viewbox x:Name="OtterScene" Visibility="Collapsed" IsHitTestVisible="False"
                         VerticalAlignment="Top" Stretch="Uniform" Margin="10,1,10,0">
                    <Canvas Width="108" Height="84">
                        <Canvas x:Name="OtterArt">
                            <!-- The chin meets the lip of the panel at y=70. Only the paws extend past it. -->
                            <Path Fill="#80513F" Stroke="#4F302C" StrokeThickness="2"
                                  Data="M24,53 C17,53 16,42 21,38 Q26,34 32,40 Z M84,53 C91,53 92,42 87,38 Q82,34 76,40 Z" />
                            <Path Fill="#BC846A" Data="M22,45 Q22,38 28,41 L28,47 Q24,50 22,45 Z M86,45 Q86,38 80,41 L80,47 Q84,50 86,45 Z" />
                            <Path Fill="#B97C52" Stroke="#4F302C" StrokeThickness="2"
                                  Data="M23,53 C23,38 37,32 53,32 C70,32 85,39 85,54 C85,66 74,71 54,72 C34,72 23,67 23,53 Z" />
                            <Path Fill="#D69E70" Data="M30,50 C30,42 42,35 55,36 Q72,36 78,48 Q68,42 55,43 Q41,42 30,50 Z" />
                            <Path Fill="#FFE4BB" Data="M30,57 C32,51 44,51 54,55 C63,50 77,51 79,57 C82,65 69,70 54,70 C39,70 28,65 30,57 Z" />
                            <Canvas Canvas.Left="38" Canvas.Top="47">
                                <Canvas.RenderTransform><ScaleTransform x:Name="OtterEyes" CenterY="3.5" /></Canvas.RenderTransform>
                                <Ellipse Width="5" Height="7" Fill="#302321" />
                                <Ellipse Canvas.Left="27" Width="5" Height="7" Fill="#302321" />
                                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="1.5" Height="1.5" Fill="#FFF7E7" />
                                <Ellipse Canvas.Left="28" Canvas.Top="1" Width="1.5" Height="1.5" Fill="#FFF7E7" />
                            </Canvas>
                            <Path Fill="#4F302C" Data="M46,54 Q54,51 62,54 Q61,59 54,61 Q48,60 46,54 Z" />
                            <Path Stroke="#624034" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M48,63 Q51,66 54,61 Q57,66 60,63" />
                            <Path Stroke="#966751" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M39,57 L28,55 M39,60 L27,61 M69,57 L80,55 M69,60 L81,61" />
                            <Path Fill="#C88C62" Stroke="#4F302C" StrokeThickness="1.5"
                                  Data="M22,70 C22,65 27,64 31,65 C36,64 40,67 40,71 L39,76 Q36,79 31,77 Q25,79 22,75 Z M68,70 C68,66 72,64 77,65 C81,64 86,66 86,70 L86,75 Q83,79 77,77 Q72,79 69,76 Z" />
                            <Path Stroke="#80513F" StrokeThickness="1.2" StrokeStartLineCap="Round"
                                  Data="M28,72 L28,76 M34,72 L34,76 M74,72 L74,76 M80,72 L80,76" />
                        </Canvas>
                        <Canvas x:Name="RikkaArt" Visibility="Collapsed">
                            <Canvas>
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="0.56" ScaleY="0.56" />
                                        <TranslateTransform X="-3" Y="1" />
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Image Source="{StaticResource RikkaPortrait}" Width="204" Height="192">
                                    <Image.Clip>
                                        <GeometryGroup FillRule="EvenOdd">
                                            <PathGeometry Figures="M62,43 C60,28 70,22 80,23 C91,23 99,29 101,41 L123,44 151,37 149,52 Q159,47 162,56 Q164,62 158,69 C160,78 163,94 164,106 L161,115 155,118 150,116 142,122 Q130,126 118,118 Q106,127 91,126 Q83,126 77,121 L68,124 61,129 55,123 49,112 50,99 46,100 48,87 39,84 46,78 54,63 53,36 Z M65,42 Q64,30 78,27 Q90,26 98,41 Z" />
                                            <PathGeometry Figures="M54,37 L70,44 55,62 Z M127,45 L150,38 145,60 139,66 Z" />
                                        </GeometryGroup>
                                    </Image.Clip>
                                </Image>
                                <Image Source="{StaticResource RikkaPortrait}" Width="204" Height="192">
                                    <Image.Clip><PathGeometry Figures="M54,37 L70,44 55,62 Z" /></Image.Clip>
                                    <Image.RenderTransform><RotateTransform x:Name="RikkaLeftEar" CenterX="59" CenterY="55" /></Image.RenderTransform>
                                </Image>
                                <Image Source="{StaticResource RikkaPortrait}" Width="204" Height="192">
                                    <Image.Clip><PathGeometry Figures="M127,45 L150,38 145,60 139,66 Z" /></Image.Clip>
                                    <Image.RenderTransform><RotateTransform x:Name="RikkaRightEar" CenterX="140" CenterY="54" /></Image.RenderTransform>
                                </Image>
                                <Canvas x:Name="RikkaClosedEye" Opacity="0">
                                    <Path Fill="#FCE3D8" Data="M102,89 Q113,85 122,93 Q121,104 111,105 Q102,103 102,89 Z" />
                                    <Path Stroke="#403345" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M103,94 Q111,101 120,94 L123,92" />
                                </Canvas>
                            </Canvas>
                            <Path Fill="#FFE1D3" Stroke="#714E57" StrokeThickness="1.3"
                                  Data="M23,72 Q22,67 26,66 Q28,64 31,66 Q34,64 36,66 Q40,65 41,70 L41,75 Q40,79 36,78 Q32,80 29,78 Q25,79 23,76 Z M67,70 Q68,65 72,66 Q74,64 77,66 Q80,64 82,66 Q86,67 85,72 L85,76 Q83,79 79,78 Q76,80 72,78 Q68,79 67,75 Z" />
                            <Path Stroke="#B58180" StrokeThickness=".9" StrokeStartLineCap="Round"
                                  Data="M28,72 L28,76 M34,72 L34,76 M74,72 L74,76 M80,72 L80,76" />
                        </Canvas>
                        <Canvas x:Name="RoxyArt" Visibility="Collapsed">
                            <Canvas>
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="0.127" ScaleY="0.127" />
                                        <TranslateTransform X="-13" Y="11" />
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Image Source="{StaticResource RoxyPortrait}" Width="1000" Height="1414">
                                    <Image.Clip>
                                        <PathGeometry Figures="M414,66 C425,61 432,74 455,67 Q505,62 548,43 Q573,58 588,88 C620,111 649,139 652,178 Q671,202 700,244 C766,271 794,303 846,314 Q888,318 906,333 Q915,343 878,352 Q834,362 792,355 L714,353 Q707,369 708,397 Q713,414 708,437 Q714,464 692,471 Q674,472 655,454 Q641,467 619,458 L611,446 Q591,458 570,461 Q552,465 532,453 Q508,453 481,432 Q458,449 445,445 Q429,461 413,453 Q400,449 400,432 Q408,404 414,378 Q409,360 418,339 Q401,344 380,340 L396,321 Q370,315 341,310 Q300,304 278,295 Q210,282 172,252 Q136,225 142,206 Q157,202 171,211 Q218,227 283,224 Q322,229 358,225 Q390,225 416,222 Q443,180 489,145 L538,113 Q520,94 485,95 Q445,87 415,76 Z" />
                                    </Image.Clip>
                                </Image>
                                <Path Data="M273,223 Q322,229 358,225 L385,225 Q357,244 343,260 L351,311 Q307,304 277,295 Q280,252 273,223 Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.6,1">
                                            <GradientStop Color="#776F62" />
                                            <GradientStop Color="#494541" Offset="0.6" />
                                            <GradientStop Color="#3E3D3D" Offset="1" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Canvas x:Name="RoxyClosedEyes" Opacity="0">
                                    <Path Fill="#FFDED1" Data="M468,371 Q487,355 502,366 Q511,372 509,386 Q489,400 471,395 Z M592,344 L605,341 611,365 602,373 Z" />
                                    <Path Stroke="#534048" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M471,373 Q491,388 505,370 M597,354 Q604,362 607,351" />
                                </Canvas>
                            </Canvas>
                            <Path Fill="#FFE1D3" Stroke="#714E57" StrokeThickness="1.3"
                                  Data="M23,72 Q22,67 26,66 Q28,64 31,66 Q34,64 36,66 Q40,65 41,70 L41,75 Q40,79 36,78 Q32,80 29,78 Q25,79 23,76 Z M67,70 Q68,65 72,66 Q74,64 77,66 Q80,64 82,66 Q86,67 85,72 L85,76 Q83,79 79,78 Q76,80 72,78 Q68,79 67,75 Z" />
                            <Path Stroke="#B58180" StrokeThickness=".9" StrokeStartLineCap="Round"
                                  Data="M28,72 L28,76 M34,72 L34,76 M74,72 L74,76 M80,72 L80,76" />
                        </Canvas>
                    </Canvas>
                </Viewbox>
                <Border x:Name="PhotoPlate" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Margin="7,0,0,7" CornerRadius="6" Padding="6,1,6,2" Background="#B0000000">
                    <TextBlock x:Name="PhotoPlateText" Text="" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" />
                </Border>
            </Grid>
        </Border>

        <!-- 迷你款 -->
        <Border x:Name="MiniLayer" CornerRadius="20" Height="96" Visibility="Collapsed"
                MouseLeftButtonDown="OnDragWindow" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                    <GradientStop x:Name="MiniTop" Color="#221B3B" Offset="0" />
                    <GradientStop x:Name="MiniBottom" Color="#120F22" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0">
                <c:DeviceGlyph x:Name="MiniGlyph" Kind="Mouse" Width="15" Height="15" HorizontalAlignment="Center"
                               GlyphBrush="#B4A5D6" Margin="0,0,0,1" />
                <TextBlock x:Name="MiniText" Text="--" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="#ECE7FA" />
                <Border x:Name="MiniBar" Width="26" Height="3" CornerRadius="1.5" Background="#7FE7C4"
                        HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 环形刻度款：圆环直接浮在桌面上，不压底色 -->
        <Border x:Name="RingLayer" CornerRadius="20" Width="96" Height="96" Visibility="Collapsed"
                Background="Transparent"
                MouseLeftButtonDown="OnDragWindow" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd"
                MouseRightButtonUp="OnContextMenu">
            <Grid>
                <Ellipse Width="56" Height="56" Stroke="#30FFFFFF" StrokeThickness="5" />
                <Path x:Name="RingArc" Stroke="#7FE7C4" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="RingText" Text="--" FontSize="17" FontWeight="Bold" Foreground="#ECE7FA"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 横向胶囊款 -->
        <Border x:Name="PillLayer" CornerRadius="20" Width="96" Height="96" Visibility="Collapsed"
                MouseLeftButtonDown="OnDragWindow" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd"
                MouseRightButtonUp="OnContextMenu">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                    <GradientStop x:Name="PillTop" Color="#221B3B" Offset="0" />
                    <GradientStop x:Name="PillBottom" Color="#120F22" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border Width="78" Height="32" CornerRadius="16" Background="#33FFFFFF"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <c:DeviceGlyph x:Name="PillGlyph" Kind="Mouse" Width="12" Height="12" GlyphBrush="#B4A5D6" />
                    <TextBlock x:Name="PillText" Text="--" FontSize="15" FontWeight="Bold" Foreground="#ECE7FA"
                               Margin="5,0,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 经典电池款 -->
        <Border x:Name="BatteryLayer" CornerRadius="20" Width="96" Height="96" Visibility="Collapsed"
                MouseLeftButtonDown="OnDragWindow" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd"
                MouseRightButtonUp="OnContextMenu">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                    <GradientStop x:Name="BatteryTop" Color="#221B3B" Offset="0" />
                    <GradientStop x:Name="BatteryBottom" Color="#120F22" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Width="66" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="5" BorderThickness="2.5" BorderBrush="#9AB4A5D6" Background="#1AFFFFFF" />
                <Border Width="4" Height="12" CornerRadius="1.5" Background="#9AB4A5D6"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-7,0" />
                <Border x:Name="BatteryFill" CornerRadius="2" Background="#7FE7C4"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="4" Width="24" />
                <TextBlock x:Name="BatteryText" Text="--" FontSize="12.5" FontWeight="Bold" Foreground="#ECE7FA"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 轻量数字款：只有数字和一条下划线，不压底色 -->
        <Border x:Name="PlainLayer" CornerRadius="20" Width="96" Height="96" Visibility="Collapsed"
                Background="Transparent"
                MouseLeftButtonDown="OnDragWindow" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd"
                MouseRightButtonUp="OnContextMenu">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="PlainText" Text="--" FontSize="30" FontWeight="Bold" Foreground="#ECE7FA"
                           HorizontalAlignment="Center" />
                <Border x:Name="PlainBar" Width="34" Height="3" CornerRadius="1.5" Background="#7FE7C4"
                        Margin="0,5,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 多电量迷你款：每台设备一行小数字 -->
        <Border x:Name="MultiLayer" CornerRadius="20" Width="96" Height="96" Visibility="Collapsed"
                MouseLeftButtonDown="OnDragWindow" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd"
                MouseRightButtonUp="OnContextMenu">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                    <GradientStop x:Name="MultiTop" Color="#221B3B" Offset="0" />
                    <GradientStop x:Name="MultiBottom" Color="#120F22" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel x:Name="MultiPanel" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>

        <!-- 共享设备列表：只显示设备图标 + 电量，不带名字 -->
        <ItemsControl x:Name="DeviceList" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                      Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="6" Padding="6,1,6,2" Background="#B8000000" Margin="3,2" c:DeviceActions.Enabled="True">
                        <StackPanel Orientation="Horizontal">
                            <c:DeviceGlyph Kind="{Binding Kind}" Width="10" Height="10"
                                           GlyphBrush="#D9FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LevelText}" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#FFFFFF" Margin="5,0,0,0" VerticalAlignment="Center" />
                            <c:ChargingGlyph Active="{Binding IsChargingActive}" Full="{Binding IsFullActive}" Width="15" Height="13" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Grid>
        <UniformGrid x:Name="ReferenceIcons" Columns="2" Visibility="Collapsed" />
    </Grid>
</Window>
