<Window x:Class="MouseDock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MouseDock.Controls"
        Title="MouseDock 设置"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" Topmost="False" ResizeMode="CanResizeWithGrip"
        Width="760" Height="620" MinWidth="680" MinHeight="500" WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="AppearanceModeChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="ModeSurface" Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource ControlOutlineBrush}" BorderThickness="1" CornerRadius="9" Padding="12,9"><ContentPresenter HorizontalAlignment="Center" RecognizesAccessKey="True"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeSurface" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="ModeSurface" Property="Background" Value="{DynamicResource ThemeChoiceBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ModeSurface" Property="BorderBrush" Value="{DynamicResource ControlAccentBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <SolidColorBrush x:Key="ThemeChoiceBrush" Color="#293A35"/>

        <Style x:Key="EdgeStyleChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tile" Background="{DynamicResource ControlFillBrush}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="7,5">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Path x:Name="Check" Data="M 0,4 L 3,7 L 8,1"
                                      Stroke="{DynamicResource ControlAccentBrush}" StrokeThickness="1.5"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ThemeChoiceBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource ControlAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource ControlOutlineBrush}" BorderThickness="1" CornerRadius="7" Padding="9,6"><Grid><ContentPresenter/><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}"/></Grid></Border></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" Margin="9,6,25,6" VerticalAlignment="Center"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="{DynamicResource MenuSurfaceBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlOutlineBrush}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="5">
                                <ScrollViewer MaxHeight="280"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="ControlOutlineBrush" Color="#8995A3"/>
        <SolidColorBrush x:Key="ControlFillBrush" Color="#292F38"/>
        <SolidColorBrush x:Key="ControlAccentBrush" Color="#8FDFC3"/>
        <SolidColorBrush x:Key="ControlMarkBrush" Color="#171C22"/>
        <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#20262E"/>
        <!-- 这四个跟着主题换，浅色主题下用深字、深卡片，不会糊成一片 -->
        <SolidColorBrush x:Key="TextBrush" Color="#ECE7FA" />
        <SolidColorBrush x:Key="CardBrush" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#28FFFFFF" />
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="3,18,0,10" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="15,13" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlOutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InvisibleRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="MinWidth" Value="6"/><Setter Property="MaxWidth" Value="6"/>
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="1,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeat}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeat}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="{DynamicResource ControlOutlineBrush}" Margin="1,2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="5" BorderThickness="1.2"
                                    BorderBrush="{DynamicResource ControlOutlineBrush}" Background="{DynamicResource ControlFillBrush}" VerticalAlignment="Center" Margin="0,0,9,0">
                                <Path x:Name="Tick" Width="9" Height="7" Data="M 0,3 L 3,6 L 9,0" Stroke="{DynamicResource ControlMarkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background"
                                        Value="{DynamicResource ControlAccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{DynamicResource ControlAccentBrush}" />
                                <Setter TargetName="Tick" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ControlAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border x:Name="SliderRail" Height="3" CornerRadius="2" Background="{DynamicResource ControlOutlineBrush}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeat}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeat}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Width="12" Height="12"
                                                             Fill="{DynamicResource ControlAccentBrush}" />
                                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource ControlMarkBrush}" HorizontalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="20" Padding="18,16,18,14">
        <Border.Background>
            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop x:Name="BgTopStop" Color="#221B3B" Offset="0" />
                <GradientStop x:Name="BgBottomStop" Color="#120F22" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect x:Name="RootShadow" BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="SettingsTitleBar" Grid.Row="0" Background="Transparent" PreviewMouseLeftButtonDown="OnDragWindow" Margin="0,0,0,4" MinHeight="32">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MouseDock / 设置" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" FontSize="10.5" Opacity="0.45" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                </StackPanel>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" Width="30" Height="28" Style="{StaticResource GhostButton}" Padding="0" Click="OnCloseButtonClick" AutomationProperties.Name="关闭设置">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" />
                </Button>
            </Grid>

<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DockPanel Margin="0,18,16,0"><TextBlock DockPanel.Dock="Bottom" Text="安静常驻，抬眼即见。" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="8,18,0,12"/><StackPanel x:Name="SectionNavigation"><Button Content="显示与样式" Tag="display" Click="OnSectionClick" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,7" Padding="12,11"/><Button Content="我的设备" Tag="devices" Click="OnSectionClick" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,7" Padding="12,11"/><Button Content="外观" Tag="appearance" Click="OnSectionClick" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,7" Padding="12,11"/><Button Content="常驻与交互" Tag="behavior" Click="OnSectionClick" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,7" Padding="12,11"/><Button Content="电量与提醒" Tag="battery" Click="OnSectionClick" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,7" Padding="12,11"/><Button Content="帮助与高级" Tag="help" Click="OnSectionClick" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,7" Padding="12,11"/></StackPanel></DockPanel><ScrollViewer x:Name="RootScroll" Grid.Column="1" Margin="12,16,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,8"><StackPanel x:Name="PageDisplay" Visibility="Visible"><TextBlock Text="显示与样式" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="选择电量陪伴你的方式。" FontSize="13" Opacity="0.7" Margin="0,6,0,12"/><Border Style="{StaticResource Card}"><Grid><TextBlock Text="卡片密度" Style="{StaticResource RowText}"/><ComboBox x:Name="DockDensityChoice" Width="150" HorizontalAlignment="Right" SelectionChanged="OnDockDensityChanged"><ComboBoxItem Content="标准" Tag="standard"/><ComboBoxItem Content="紧凑" Tag="compact"/><ComboBoxItem Content="极简" Tag="bare"/></ComboBox></Grid></Border><TextBlock Text="显示方式" Style="{StaticResource Section}"/>
<Border Style="{StaticResource Card}">
                        <StackPanel>
                            <UniformGrid Columns="3" Margin="-4,0">
                                <UniformGrid.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="MinHeight" Value="56"/>
                                        <Setter Property="Margin" Value="4"/>
                                        <Setter Property="Padding" Value="6,7"/>
                                        <EventSetter Event="Click" Handler="OnSurfaceClick"/>
                                    </Style>
                                </UniformGrid.Resources>
                                <Button x:Name="SurfaceDock" Content="卡片窗" Tag="dock"/>
                                <Button x:Name="SurfaceMini" Content="迷你" Tag="mini"/>
                                <Button x:Name="SurfaceIcon" Content="悬浮图标" Tag="icon"/>
                                <Button x:Name="SurfaceTaskbar" Content="任务栏" Tag="taskbar"/>
                                <Button x:Name="SurfaceEdge" Content="屏幕右侧" Tag="edge"/>
                                <Button x:Name="SurfacePet" Content="桌宠" Tag="pet"/>
                            </UniformGrid>
                            <StackPanel x:Name="IconOptionsPanel">
                            <TextBlock Text="悬浮图标样式" FontWeight="SemiBold" Margin="0,14,0,5"/>
                            <UniformGrid x:Name="IconStyleChoices" Columns="3" Margin="-3,5,-3,0"/>
                            <TextBlock Text="悬浮图标大小（滚轮也可调节）" Margin="0,12,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                <Slider x:Name="IconScaleSlider" Minimum="0.5" Maximum="3" ValueChanged="OnIconScaleChanged"/>
                                <TextBlock x:Name="IconScaleValue" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/>
                                <Button Content="重置" Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="4,3" Click="OnResetIconScale"/>
                            </Grid>
                            <TextBlock Text="50%–300%，仅影响悬浮图标。照片内部缩放使用 Ctrl+滚轮。" FontSize="10" TextWrapping="Wrap" Opacity="0.65" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="ReferenceAppearanceOptions" Margin="0,10,0,0">
                                <CheckBox x:Name="IconFollowThemeBox" Content="跟随界面主题色" Checked="OnIconOptionsChanged" Unchecked="OnIconOptionsChanged"/>
                                <CheckBox x:Name="IconHideBackgroundBox" Content="隐藏图标底色" Checked="OnIconOptionsChanged" Unchecked="OnIconOptionsChanged"/>
                                <Button Content="角色与照片…" Style="{StaticResource GhostButton}" Click="OnEditCharacter" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="默认角色" Style="{StaticResource RowText}"/>
                                    <ComboBox x:Name="ReferenceCharacterChoices" Width="160" HorizontalAlignment="Right" SelectionChanged="OnReferenceCharacterChanged">
                                        <ComboBoxItem Content="星蓝" Tag="rei"/>
                                        <ComboBoxItem Content="橘焰" Tag="asuka"/>
                                        <ComboBoxItem Content="薄荷芽" Tag="peek"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="照片" Style="{StaticResource RowText}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource GhostButton}" ToolTip="编辑照片" Click="OnPickReferencePhoto" Padding="9,6">
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" ToolTip="清除照片" Click="OnClearReferencePhoto" Padding="9,6" Margin="7,0,0,0">
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="充电动效" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="ChargeEffectChoice" Width="110" SelectionChanged="OnChargeEffectChanged">
                                    <ComboBoxItem Content="扫光"/>
                                    <ComboBoxItem Content="流光／波浪"/>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="TaskbarFollowIconsBox" Content="自动跟随任务栏图标" Margin="0,14,0,0" Checked="OnTaskbarFollowIconsChanged" Unchecked="OnTaskbarFollowIconsChanged"/>
                            <Grid x:Name="TaskbarIconOffsetRow" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="图标偏移" Style="{StaticResource RowText}"/>
                                <Grid Grid.Column="1" Margin="14,0,8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Slider x:Name="TaskbarIconOffsetSlider" Width="Auto" Minimum="-300" Maximum="300" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnTaskbarIconOffsetChanged" AutomationProperties.Name="图标偏移"/>
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" IsHitTestVisible="False">
                                        <Border Width="1" Height="4" Background="{DynamicResource TextBrush}" Opacity="0.5"/>
                                        <TextBlock Text="0" FontSize="10" HorizontalAlignment="Center" Opacity="0.65"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="TaskbarIconOffsetInput" Width="52" Padding="3,2" FontSize="12.5" TextAlignment="Center" VerticalContentAlignment="Center" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderBrush="{DynamicResource ButtonBrush}" BorderThickness="1" LostFocus="OnTaskbarIconOffsetInputLostFocus" KeyDown="OnTaskbarIconOffsetInputKeyDown" AutomationProperties.Name="图标偏移数值"/>
                                    <TextBlock Text="px" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.65"/>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="TaskbarPositionRow" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="任务栏位置（%）" Style="{StaticResource RowText}"/>
                                <Slider x:Name="TaskbarOffsetSlider" Grid.Column="1" Minimum="0" Maximum="100" Width="Auto" Margin="14,0,8,0" SmallChange="1" LargeChange="10" ToolTip="相对任务栏可用长度的百分比；2K/4K 和高 DPI 自动等比缩放" ValueChanged="OnTaskbarOffsetChanged"/>
                                <TextBlock x:Name="TaskbarOffsetValue" Grid.Column="2" TextAlignment="Right" Style="{StaticResource RowText}" Opacity="0.65"/>
                            </Grid>
                            <StackPanel x:Name="TaskbarStylePanel" Margin="0,14,0,0">
                                <TextBlock Text="任务栏样式" Style="{StaticResource RowText}"/>
                                <UniformGrid x:Name="TaskbarStyleChoices" Columns="3" Margin="0,6,0,0"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="整体大小" Style="{StaticResource RowText}"/>
                                    <Slider x:Name="TaskbarSizeSlider" Grid.Column="1" Minimum="50" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True" Margin="14,0,8,0" ToolTip="也可在任务栏电量图标上滚动调节；实际大小受任务栏高度限制" ValueChanged="OnTaskbarSizeChanged"/>
                                    <TextBlock x:Name="TaskbarSizeValue" Grid.Column="2" Style="{StaticResource RowText}" TextAlignment="Right"/>
                                    <Button x:Name="TaskbarSizeReset" Grid.Column="3" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="7,5" ToolTip="恢复大小为 100%" Click="OnResetTaskbarSize">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="文字颜色" Style="{StaticResource RowText}"/>
                                    <Button x:Name="TaskbarTextColorSwatch" Grid.Column="1" Width="44" Height="22" Margin="14,0,8,0" Tag="text" Click="OnPickTaskbarColor" BorderThickness="1"/>
                                    <TextBlock x:Name="TaskbarTextColorLabel" Grid.Column="2" Style="{StaticResource RowText}" Opacity="0.65"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="电量颜色" Style="{StaticResource RowText}"/>
                                    <Button x:Name="TaskbarBatteryColorSwatch" Grid.Column="1" Width="44" Height="22" Margin="14,0,8,0" Tag="battery" Click="OnPickTaskbarColor" BorderThickness="1"/>
                                    <TextBlock x:Name="TaskbarBatteryColorLabel" Grid.Column="2" Style="{StaticResource RowText}" Opacity="0.65"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel x:Name="EdgeOptionsPanel" Margin="0,12,0,0">
                                <TextBlock Text="屏幕右侧样式" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <UniformGrid x:Name="EdgeStyleChoices" Columns="3" Margin="0,2,-8,8"/>
                                <Grid Margin="0,0,0,12">
