<Window x:Class="MouseDock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MouseDock 设置"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="False" ResizeMode="NoResize"
        Width="396" SizeToContent="Height" SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="3,14,0,7" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#ECE7FA" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InvisibleRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="1,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeat}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeat}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#33FFFFFF" Margin="1,2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#ECE7FA" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="5" BorderThickness="1.2"
                                    BorderBrush="#4DFFFFFF" Background="#0AFFFFFF" VerticalAlignment="Center" Margin="0,0,9,0">
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                                           Foreground="#12101C" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background"
                                        Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter TargetName="Tick" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#80FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="3" CornerRadius="2" Background="#26FFFFFF" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeat}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InvisibleRepeat}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Width="12" Height="12"
                                                             Fill="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Ellipse Width="4" Height="4" Fill="#88FFFFFF" HorizontalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="20" Padding="18,16,18,14">
        <Border.Background>
            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop x:Name="BgTopStop" Color="#221B3B" Offset="0" />
                <GradientStop x:Name="BgBottomStop" Color="#120F22" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect x:Name="RootShadow" BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="OnDragWindow" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Text="  v0.1.0 · 复刻版" FontSize="10.5" Opacity="0.45" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                </StackPanel>
                <Border x:Name="CloseButton" HorizontalAlignment="Right" Width="24" Height="24" CornerRadius="8" Background="#12FFFFFF" Cursor="Hand" PreviewMouseLeftButtonDown="OnCloseClick">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" />
                </Border>
            </Grid>

            <ScrollViewer x:Name="RootScroll" Grid.Row="1" MaxHeight="620" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,4,0,0">

                    <TextBlock Text="主题" Style="{StaticResource Section}" />
                    <ListBox x:Name="ThemeList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnThemeSelected">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Box" CornerRadius="12" Padding="11,8" Margin="0,0,0,6"
                                        Background="#09FFFFFF" BorderThickness="1.4" BorderBrush="Transparent">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="18" CornerRadius="6" Background="{Binding Swatch}" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0"
                                                   Foreground="{Binding AccentBrush}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Box" Property="BorderBrush" Value="{Binding AccentBrush}" />
                                        <Setter TargetName="Box" Property="Background" Value="#14FFFFFF" />
                                        <Setter TargetName="Tick" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="自定义背景 · 取主色" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PickBgButton" Content="选择图片" Style="{StaticResource GhostButton}" Click="OnPickBackground" />
                                <Button x:Name="ClearBgButton" Content="清除" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnClearBackground" />
                                <Border x:Name="AccentSwatch" Width="18" Height="18" CornerRadius="6" Background="#B49CFF"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,2,0" />
                            </StackPanel>
                            <TextBlock x:Name="AccentText" Text="未选择背景图" FontSize="10.5" Opacity="0.5" Margin="0,7,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="多电量迷你 · 显示设备（最多 5 台）" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <ItemsControl x:Name="DeviceChecks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected, Mode=TwoWay}"
                                              Checked="OnDeviceChecked" Unchecked="OnDeviceChecked" Foreground="#ECE7FA" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock x:Name="DeviceHint" Text="勾选后同步到迷你视图；同类设备可多台" FontSize="10" Opacity="0.42" Margin="3,0,0,2" />

                    <TextBlock Text="悬浮图标" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ModeCharacter" Content="角色" Style="{StaticResource GhostButton}" Click="OnModeCharacter" />
                                <Button x:Name="ModePhoto" Content="照片" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnModePhoto" />
                                <Button x:Name="ModeMini" Content="迷你" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnModeMini" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button x:Name="PickCharButton" Content="换角色图" Style="{StaticResource GhostButton}" Click="OnPickCharacter" />
                                <Button x:Name="PickPhotoButton" Content="换照片" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnPickPhoto" />
                            </StackPanel>
                            <TextBlock Text="照片款：滚轮缩放、拖动取景" FontSize="10" Opacity="0.42" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="外观" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="不透明度" Style="{StaticResource RowText}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider x:Name="OpacitySlider" Minimum="0.55" Maximum="1" SmallChange="0.01"
                                            ValueChanged="OnOpacityChanged" />
                                    <TextBlock x:Name="OpacityValue" Text="96%" Width="42" TextAlignment="Right"
                                               Style="{StaticResource RowText}" Opacity="0.65" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="界面缩放" Style="{StaticResource RowText}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider x:Name="ScaleSlider" Minimum="0.8" Maximum="1.3" SmallChange="0.05"
                                            ValueChanged="OnScaleChanged" />
                                    <TextBlock x:Name="ScaleValue" Text="100%" Width="42" TextAlignment="Right"
                                               Style="{StaticResource RowText}" Opacity="0.65" />
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="AutoStartCheck" Content="开机自启" Margin="0,12,0,0" Click="OnAutoStartClick" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="数据源" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ProviderAuto" Content="自动检测" Style="{StaticResource GhostButton}" Click="OnProviderAuto" />
                                <Button x:Name="ProviderDemo" Content="演示" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnProviderDemo" />
                                <Button x:Name="ProviderJson" Content="JSON" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnProviderJson" />
                                <Button x:Name="ProviderHid" Content="HID 实验" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnProviderHid" />
                            </StackPanel>

                            <CheckBox x:Name="SafeModeBox" Content="安全模式（不向厂商通道写入，杀软更友好）"
                                      FontSize="11" Opacity="0.8" Margin="0,10,0,0"
                                      Checked="OnSafeModeChanged" Unchecked="OnSafeModeChanged" />
                            <TextBlock x:Name="ProviderHint" Text="自动检测本机真实设备" FontSize="10" Opacity="0.42" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="刷新间隔" Style="{StaticResource RowText}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider x:Name="RefreshSlider" Minimum="5" Maximum="120" SmallChange="5"
                                            ValueChanged="OnRefreshChanged" />
                                    <TextBlock x:Name="RefreshValue" Text="30s" Width="42" TextAlignment="Right"
                                               Style="{StaticResource RowText}" Opacity="0.65" />
                                </StackPanel>
                            </Grid>
                            <Button x:Name="OpenDataButton" Content="打开数据目录" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnOpenDataDir" />
                            <Button x:Name="DetectButton" Content="查看探测报告（本机真实设备）" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnOpenDetectReport" />
                            <Button x:Name="CaptureButton" Content="抓取 2.4G 报文（8 秒）" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnCapture24G" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="左键拖动窗口 · 右键打开快捷菜单 · 双击托盘图标显示全部"
                               FontSize="10" Opacity="0.34" Margin="3,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
