<Window x:Class="MouseDock.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MouseDock.Controls"
        Title="MouseDock"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal">

    <Border x:Name="Root" Width="268" CornerRadius="18" Padding="12,10,12,9"
            BorderThickness="1" BorderBrush="#12FFFFFF"
            MouseLeftButtonDown="OnDragWindow" MouseRightButtonUp="OnContextMenu">
        <Border.Background>
            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop x:Name="BgTopStop" Color="#221B3B" Offset="0" />
                <GradientStop x:Name="BgBottomStop" Color="#120F22" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="RootShadow" BlurRadius="26" ShadowDepth="9" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <Grid Grid.Row="0" Margin="2,0,2,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="5" Margin="0,0,6,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="LogoStop1" Color="#B49CFF" Offset="0" />
                                <GradientStop x:Name="LogoStop2" Color="#F0A6D0" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="MouseDock" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="LiveDot" Width="5" Height="5" Margin="0,0,6,0" Opacity="0.8" />
                    <TextBlock x:Name="ThemeNameText" Text="暮色蓝紫" FontSize="9.5" Opacity="0.6" />
                </StackPanel>
            </Grid>

            <!-- 设备列表 -->
            <ItemsControl x:Name="DeviceList" Grid.Row="1">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" CornerRadius="12" Padding="6,5,6,5" Margin="0,0,0,3"
                                Background="Transparent" SnapsToDevicePixels="True"
                                ToolTip="{Binding Note}" ToolTipService.ShowDuration="12000">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:DeviceGlyph x:Name="Glyph" Kind="{Binding Kind}" Width="14" Height="14"
                                                   Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.75"
                                                   GlyphBrush="{Binding GlyphBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MetaLabel}" FontSize="9" Opacity="0.5" Margin="0,0,0,1" />
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="112" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="Pct" Text="{Binding LevelText}" FontSize="17" FontWeight="Bold" Opacity="{Binding ValueOpacity}"
                                               Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <c:MeterBar Width="62" Height="9" Value="{Binding LevelFraction}"
                                                Accent="{Binding AccentColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Accent2="{Binding Accent2Color, RelativeSource={RelativeSource AncestorType=Window}}"
                                                TrackBrush="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Connected}" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.42" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 底栏 -->
            <Grid Grid.Row="2" Margin="2,7,2,0">
                <TextBlock x:Name="FooterText" Text="电量，一起看见" FontSize="9.5" Opacity="0.42"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="SourceChip" CornerRadius="8" Padding="7,3" Background="#10FFFFFF" Margin="0,0,6,0">
                        <TextBlock x:Name="SourceText" Text="演示数据" FontSize="9.5" Opacity="0.6" />
                    </Border>
                    <Border x:Name="GearButton" Width="22" Height="22" CornerRadius="8" Background="#14FFFFFF"
                            Cursor="Hand" PreviewMouseLeftButtonDown="OnGearClick">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
