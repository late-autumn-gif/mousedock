<Window x:Class="MouseDock.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MouseDock.Controls"
        xmlns:v="clr-namespace:MouseDock.Views"
        Title="MouseDock"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ShowInTaskbar="False" Topmost="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="DockAction" TargetType="Button">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/><Setter Property="MinWidth" Value="27"/><Setter Property="MinHeight" Value="27"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ActionSurface" Background="{TemplateBinding Background}" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionSurface" Property="Background" Value="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType=Window}}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ActionSurface" Property="BorderBrush" Value="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType=Window}}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DpiAction" TargetType="Button" BasedOn="{StaticResource DockAction}">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate><TextBlock Text="{Binding}" TextAlignment="Center" TextWrapping="Wrap"/></DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="ActionSurface" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="ActionSurface" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="-2"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="ActionSurface" Property="Effect">
                                    <Setter.Value><DropShadowEffect ShadowDepth="3" BlurRadius="9" Opacity="0.24"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="RenderTransform" Value="{x:Static Transform.Identity}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <v:PercentageWarningConverter x:Key="PercentageWarning" />
    </Window.Resources>

    <Border x:Name="Root" Width="316" CornerRadius="16" Padding="15,12,15,10"
            BorderThickness="1" BorderBrush="#12FFFFFF"
            MouseRightButtonUp="OnContextMenu" PreviewMouseLeftButtonDown="OnCardPointerDown">
        <Border.Background>
            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop x:Name="BgTopStop" Color="#221B3B" Offset="0" />
                <GradientStop x:Name="BgBottomStop" Color="#120F22" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="RootShadow" BlurRadius="26" ShadowDepth="9" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <Grid Grid.Row="0" Margin="2,0,2,10" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="5" Margin="0,0,6,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="LogoStop1" Color="#B49CFF" Offset="0" />
                                <GradientStop x:Name="LogoStop2" Color="#F0A6D0" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="MouseDock" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="LiveDot" Visibility="Collapsed" Width="5" Height="5"/>
                    <TextBlock x:Name="ThemeNameText" Visibility="Collapsed"/>
                    <Button x:Name="RefreshDevicesButton" Style="{StaticResource DockAction}" Click="OnRefreshDevicesClick"
                            AutomationProperties.Name="刷新设备" ToolTip="重新扫描已连接的设备">
                        <Viewbox Width="14" Height="14"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 12.8,5.2 A 5.4,5.4 0 1 0 13,10.5 M 13,2 L 13,5.5 L 9.5,5.5"/></Viewbox>
                    </Button>
                    <Button x:Name="PinButton" Style="{StaticResource DockAction}" Click="OnPinClick" AutomationProperties.Name="切换始终置顶" ToolTip="始终置顶"><Viewbox Width="14" Height="14"><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 5,1 L 11,1 M 6,1 L 6,6 L 3,10 L 13,10 L 10,6 L 10,1 M 8,10 L 8,15"/></Canvas></Viewbox></Button>
                    <Button Style="{StaticResource DockAction}" Click="OnSettingsClick" AutomationProperties.Name="打开设置"><Viewbox Width="14" Height="14"><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 8,1 L 8,4 M 8,12 L 8,15 M 1,8 L 4,8 M 12,8 L 15,8 M 3,3 L 5,5 M 11,11 L 13,13 M 3,13 L 5,11 M 11,5 L 13,3 M 8,4 A 4,4 0 1 0 8,12 A 4,4 0 1 0 8,4 M 8,6 A 2,2 0 1 0 8,10 A 2,2 0 1 0 8,6"/></Canvas></Viewbox></Button>
                    <Button Style="{StaticResource DockAction}" Click="OnHideClick" AutomationProperties.Name="收起电量窗" ToolTip="收起到托盘，继续监测"><Viewbox Width="14" Height="14"><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 2,8 L 14,8"/></Canvas></Viewbox></Button>
                </StackPanel>
            </Grid>

            <!-- 设备列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" CornerRadius="10" Padding="8,10,8,10" Margin="0,0,0,6" BorderThickness="1" BorderBrush="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                c:DeviceActions.Enabled="True"
                                Background="Transparent" SnapsToDevicePixels="True"
                                ToolTip="{Binding Name}"
                                Focusable="True" KeyDown="OnDeviceKeyDown" AutomationProperties.Name="{Binding Name}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:DeviceGlyph x:Name="Glyph" Kind="{Binding Kind}" Width="20" Height="20"
                                                   Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.75"
                                                   GlyphBrush="{Binding GlyphBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MetaLabel}" FontSize="11" Opacity="0.7" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.75" Margin="0,3,0,0"/>

                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="Pct" Text="{Binding LevelText}" FontSize="24" FontWeight="SemiBold" Opacity="{Binding ValueOpacity}"
                                               Margin="0,0,7,0" VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <MultiBinding Converter="{StaticResource PercentageWarning}">
                                                <Binding Path="Level" />
                                                <Binding Path="LowBatteryThreshold" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="IsChargingActive" />
                                                <Binding Path="IsFullActive" />
                                            </MultiBinding>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <c:MeterBar Width="56" Height="4" Value="{Binding LevelFraction}" Charging="{Binding IsChargingActive}" Opacity="{Binding ValueOpacity}"
                                                Accent="{Binding AccentColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Accent2="{Binding Accent2Color, RelativeSource={RelativeSource AncestorType=Window}}"
                                                TrackBrush="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                VerticalAlignment="Center" />
                                </StackPanel>
<Button x:Name="DeviceDpiButton" Grid.Row="1" Grid.ColumnSpan="2" Click="OnDpiClick" AutomationProperties.Name="DPI 设置" ToolTip="打开 DPI 设置" Margin="0,10,0,0" Padding="10,8" HorizontalContentAlignment="Stretch" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" Background="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="0">
 <Button.Style><Style TargetType="Button" BasedOn="{StaticResource DockAction}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Mouse"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="DPI 设置" FontSize="12"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding DpiLabel}" FontSize="12"/><TextBlock Text=" ›" Margin="8,0,0,0"/></StackPanel></Grid>
</Button>                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{Binding GlyphBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Connected}" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.42" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <Border x:Name="DetailPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,0" Padding="10" BorderThickness="1" BorderBrush="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="10">
                <StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MetaLabel}" FontSize="11" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap"/>

                    <Button Content="设备设置与更多操作…" Click="OnDeviceManagementClick" Padding="7" Margin="0,10,0,0"/>
                    <Button Content="收起详情" Click="OnCloseDetailClick" Padding="7" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" Text="未选择显示设备，可在设置中勾选" FontSize="10.5" Opacity="0.55" Margin="6,12"
                       x:Name="EmptyDeviceHint" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=DeviceList}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 底栏 -->
            <Grid Grid.Row="3" Margin="2,7,2,0">
                <TextBlock x:Name="FooterText" Text="安静常驻，抬眼即见。" FontSize="11" Opacity="0.65"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="SourceChip" Visibility="Collapsed" CornerRadius="8" Padding="7,3" Background="#10FFFFFF" Margin="0,0,6,0">
                        <TextBlock x:Name="SourceText" Text="演示数据" FontSize="9.5" Opacity="0.6" />
                    </Border>
                    <Border x:Name="GearButton" Visibility="Collapsed" Width="22" Height="22" CornerRadius="8" Background="#14FFFFFF"
                            Cursor="Hand" PreviewMouseLeftButtonDown="OnGearClick">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
