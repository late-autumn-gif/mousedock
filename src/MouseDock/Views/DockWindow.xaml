<Window x:Class="MouseDock.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MouseDock.Controls"
        xmlns:v="clr-namespace:MouseDock.Views"
        Title="MouseDock"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="DockAction" TargetType="Button">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/><Setter Property="MinWidth" Value="27"/><Setter Property="MinHeight" Value="27"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <v:PercentageWarningConverter x:Key="PercentageWarning" />
    </Window.Resources>

    <Border x:Name="Root" Width="316" CornerRadius="16" Padding="15,12,15,10"
            BorderThickness="1" BorderBrush="#12FFFFFF"
            MouseRightButtonUp="OnContextMenu" PreviewMouseLeftButtonDown="OnCardPointerDown">
        <Border.Background>
            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop x:Name="BgTopStop" Color="#221B3B" Offset="0" />
                <GradientStop x:Name="BgBottomStop" Color="#120F22" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="RootShadow" BlurRadius="26" ShadowDepth="9" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <Grid Grid.Row="0" Margin="2,0,2,10" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="5" Margin="0,0,6,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="LogoStop1" Color="#B49CFF" Offset="0" />
                                <GradientStop x:Name="LogoStop2" Color="#F0A6D0" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="MouseDock" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="LiveDot" Visibility="Collapsed" Width="5" Height="5"/>
                    <TextBlock x:Name="ThemeNameText" Visibility="Collapsed"/>
                    <Button x:Name="PinButton" Content="置顶" Style="{StaticResource DockAction}" Click="OnPinClick" AutomationProperties.Name="切换始终置顶" ToolTip="始终置顶"/>
                    <Button Content="设置" Style="{StaticResource DockAction}" Click="OnSettingsClick" AutomationProperties.Name="打开设置"/>
                    <Button Content="收起" Style="{StaticResource DockAction}" Click="OnHideClick" AutomationProperties.Name="收起电量窗" ToolTip="收起到托盘，继续监测"/>
                </StackPanel>
            </Grid>

            <!-- 设备列表 -->
            <ItemsControl x:Name="DeviceList" Grid.Row="1">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" CornerRadius="10" Padding="8,10,8,10" Margin="0,0,0,6" BorderThickness="1" BorderBrush="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                c:DeviceActions.Enabled="True"
                                Background="Transparent" SnapsToDevicePixels="True"
                                ToolTip="{Binding Name}"
                                Focusable="True" KeyDown="OnDeviceKeyDown" AutomationProperties.Name="{Binding Name}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:DeviceGlyph x:Name="Glyph" Kind="{Binding Kind}" Width="20" Height="20"
                                                   Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.75"
                                                   GlyphBrush="{Binding GlyphBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MetaLabel}" FontSize="11" Opacity="0.7" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.75" Margin="0,3,0,0"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Mouse">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <TextBlock Text="{Binding DpiLabel}" FontSize="9" Opacity="0.65">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanChangeDpi}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Content="{Binding DpiLabel}" Click="OnDpiClick" FontSize="9"
                                                    HorizontalAlignment="Left" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Background="Transparent" BorderThickness="0" Padding="0,1,3,1"
                                                    ToolTip="调整 DPI" AutomationProperties.Name="调整 DPI">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanChangeDpi}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <c:ChargingGlyph Active="{Binding IsChargingActive}" Full="{Binding IsFullActive}" Width="18" Height="17" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Pct" Text="{Binding LevelText}" FontSize="24" FontWeight="SemiBold" Opacity="{Binding ValueOpacity}"
                                               Margin="0,0,7,0" VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <MultiBinding Converter="{StaticResource PercentageWarning}">
                                                <Binding Path="Level" />
                                                <Binding Path="LowBatteryThreshold" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <c:MeterBar Width="56" Height="4" Value="{Binding LevelFraction}" Charging="{Binding IsChargingActive}" Opacity="{Binding ValueOpacity}"
                                                Accent="{Binding AccentColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Accent2="{Binding Accent2Color, RelativeSource={RelativeSource AncestorType=Window}}"
                                                TrackBrush="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{Binding GlyphBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Connected}" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.42" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="DetailPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,0" Padding="10" BorderThickness="1" BorderBrush="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="10">
                <StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MetaLabel}" FontSize="11" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap"/>

                    <Button Content="设备设置与更多操作…" Click="OnDeviceManagementClick" Padding="7" Margin="0,10,0,0"/>
                    <Button Content="收起详情" Click="OnCloseDetailClick" Padding="7" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" Text="未选择显示设备，可在设置中勾选" FontSize="10.5" Opacity="0.55" Margin="6,12"
                       x:Name="EmptyDeviceHint" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=DeviceList}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 底栏 -->
            <Grid Grid.Row="3" Margin="2,7,2,0">
                <TextBlock x:Name="FooterText" Text="安静常驻，抬眼即见。" FontSize="11" Opacity="0.65"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="SourceChip" Visibility="Collapsed" CornerRadius="8" Padding="7,3" Background="#10FFFFFF" Margin="0,0,6,0">
                        <TextBlock x:Name="SourceText" Text="演示数据" FontSize="9.5" Opacity="0.6" />
                    </Border>
                    <Border x:Name="GearButton" Visibility="Collapsed" Width="22" Height="22" CornerRadius="8" Background="#14FFFFFF"
                            Cursor="Hand" PreviewMouseLeftButtonDown="OnGearClick">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
