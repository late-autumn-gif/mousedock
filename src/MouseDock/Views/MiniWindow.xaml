<Window x:Class="MouseDock.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MouseDock.Controls"
        Title="MouseDock 迷你"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal">

    <Border x:Name="Root" CornerRadius="18" Padding="12,10" MinWidth="152"
            MouseLeftButtonDown="OnDragWindow" MouseRightButtonUp="OnContextMenu">
        <Border.Background>
            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop x:Name="BgTopStop" Color="#221B3B" Offset="0" />
                <GradientStop x:Name="BgBottomStop" Color="#120F22" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect x:Name="RootShadow" BlurRadius="20" ShadowDepth="6" Opacity="0.42" Color="#000000" />
        </Border.Effect>

        <Grid>
        <ItemsControl x:Name="CellList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Cell" CornerRadius="12" Margin="3" Padding="9,7" Background="#0DFFFFFF" c:DeviceActions.Enabled="True">
                        <StackPanel>
                            <c:DeviceGlyph Kind="{Binding Kind}" Width="13" Height="13" HorizontalAlignment="Left"
                                           Opacity="0.6" Margin="0,0,0,3"
                                           GlyphBrush="{Binding GlyphBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding MiniText}" FontSize="18" FontWeight="Bold" />
                                <c:ChargingGlyph Active="{Binding IsChargingActive}" Width="18" Height="17" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="8.5" Opacity="0.45"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cell" Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="EmptyDeviceHint" Text="未选择显示设备" FontSize="10.5" Margin="6,12" Opacity="0.55" HorizontalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=CellList}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        </Grid>
    </Border>
</Window>
